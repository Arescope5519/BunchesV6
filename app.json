{
  "expo": {
    "name": "Bunches V6",
    "slug": "bunches-v6",
    "version": "0.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-file-system",
      "expo-document-picker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bunchesai.v6",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "bunches-recipe-share",
            "CFBundleURLSchemes": ["bunches"]
          },
          {
            "CFBundleURLName": "google-signin",
            "CFBundleURLSchemes": ["com.googleusercontent.apps.307694075211-20jdrtjddj9tqa3klhkgnj7hocbhjkm1"]
          }
        ],
        "GIDClientID": "307694075211-20jdrtjddj9tqa3klhkgnj7hocbhjkm1.apps.googleusercontent.com",
        "NSUserTrackingUsageDescription": "This app does not track you."
      }
    },
    "android": {
      "package": "com.bunchesai.v6",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}