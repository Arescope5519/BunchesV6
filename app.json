{
  "expo": {
    "name": "Melibri",
    "slug": "melibri",
    "scheme": "melibri",
    "version": "0.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "./plugins/ios-share-extension.js",
      "./plugins/android-share-intent.js",
      "./plugins/android-on-new-intent.js",
      "expo-file-system",
      "expo-document-picker",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Melibri to access your photos to add images to your recipes.",
          "cameraPermission": "Allow Melibri to use your camera to take photos of your recipes."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.melibri",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "melibri-recipe-share",
            "CFBundleURLSchemes": ["melibri"]
          },
          {
            "CFBundleURLName": "google-signin",
            "CFBundleURLSchemes": ["com.googleusercontent.apps.307694075211-20jdrtjddj9tqa3klhkgnj7hocbhjkm1"]
          }
        ],
        "GIDClientID": "307694075211-20jdrtjddj9tqa3klhkgnj7hocbhjkm1.apps.googleusercontent.com",
        "NSUserTrackingUsageDescription": "This app does not track you."
      }
    },
    "android": {
      "package": "app.melibri",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}